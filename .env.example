# Symphony of One MCP Configuration

# Hub server URL (where the central coordinator runs)
CHAT_SERVER_URL=http://localhost:3000

# Port for the hub server to listen on
PORT=3000

# Shared workspace directory (absolute path recommended)
SHARED_DIR=./shared

# Data directory for persistent storage (logs, database, etc.)
DATA_DIR=./data

# Hub-managed room file storage. Keep this outside the repository and do not
# point it at a client workspace. The default is $DATA_DIR/files.
# FILE_STORE_DIR=./data/files
# The initial mode supports one deliberately trusted team sharing AUTH_TOKEN.
FILES_AUTHZ_MODE=trusted-team

# Agent display name (for MCP server instances)
AGENT_NAME=Claude-Agent-1

# File backend for MCP clients: local preserves the historic client-local
# SHARED_DIR behavior; remote uses the joined room's hub-managed file store.
SYMPHONY_FILE_BACKEND=local

# Logging configuration
LOG_LEVEL=info

# Additional configuration options
# MAX_FILE_SIZE=10485760
# MAX_MESSAGE_HISTORY=1000
# NOTIFICATION_RETENTION_DAYS=30
# MEMORY_CLEANUP_INTERVAL=3600
